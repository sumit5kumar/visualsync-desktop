{
  "name": "visualsync-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop companion for VisualSync AI",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc",
    "start": "electron .",
    "dist:win": "pnpm build && electron-builder --win nsis"
  },
  "build": {
    "appId": "ai.visualsync.desktop",
    "productName": "VisualSync Desktop",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "electron": "^37.4.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@10.4.1"
}
